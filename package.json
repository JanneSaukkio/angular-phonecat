  "license": "MIT",
  "dependencies": {
    "@angular/common": "6.1.10",
    "@angular/compiler": "6.1.10",
    "@angular/core": "6.1.10",
    "@angular/forms": "6.1.10",
    "@angular/http": "6.1.10",
    "@angular/platform-browser": "6.1.10",
    "@angular/platform-browser-dynamic": "6.1.10",
    "@angular/router": "6.1.10",
    "angular-in-memory-web-api": "0.6.1",
    "bootstrap": "3.1.1",
    "core-js": "2.6.12",
    "rxjs": "6.6.7",
    "systemjs": "0.19.40",
    "zone.js": "0.8.26"
  },
  "devDependencies": {
    "@types/jasmine": "^5.1.12",
    "http-server": "^0.9.0",
    "jasmine-core": "^2.4.1",
    "karma": "^0.13.22",
    "karma-chrome-launcher": "^0.2.3",
    "karma-firefox-launcher": "^0.1.7",
    "karma-jasmine": "^0.3.8",
    "protractor": "^4.0.9",
    "typescript": "3.9.10"
  },
  "scripts": {
    "tsc": "tsc",
    "tsc:w": "tsc -w",
